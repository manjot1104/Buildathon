# Application
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=ScopePilot

# Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/scopepilot?retryWrites=true&w=majority

# Authentication — generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
SESSION_COOKIE_NAME=scopepilot_session
SESSION_MAX_AGE_DAYS=14

# CSRF
CSRF_SECRET=change-me-to-another-long-random-secret

# Email (optional — leave blank to log emails to console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ScopePilot <noreply@example.com>"

# AI provider (optional — manual analysis works without this)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2000

# File storage (local for development; use S3-compatible in production)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# WhatsApp Cloud API (optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Billing / Stripe (optional — shows "Billing setup required" when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# Admin bootstrap (first platform admin email)
ADMIN_EMAIL=

# Logging
LOG_LEVEL=info
